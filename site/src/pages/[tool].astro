---
import Base from "../layouts/Base.astro";
import ToolIcon from "../components/ToolIcon.astro";
import { TOOLS, toolBySlug, SITE, CATEGORIES } from "../data/tools.mjs";
import { ILOVE, ILOVE_CHECKED } from "../data/compare.mjs";
import { POSTS } from "../data/posts.mjs";
export function getStaticPaths() { return TOOLS.map(t => ({ params: { tool: t.slug }, props: { t } })); }
const { t } = Astro.props;
const cat = CATEGORIES.find(c => c.id === t.category);
const related = (t.related || []).map(s => toolBySlug[s] || (s === "exam-form-ready" ? { slug: s, name: "Exam Form Ready", short: "Photo, signature & documents in exact exam KB sizes.", icon: "exam" } : null)).filter(Boolean);
const guides = POSTS.filter(p => p.tool === t.slug).slice(0, 4);
const cfg = {
  slug: t.slug, name: t.name, kind: t.kind, accept: t.accept, acceptLabel: t.acceptLabel, selectLabel: t.selectLabel,
  multiple: !!t.multiple, server: !!t.server, maxMB: t.maxMB || 0, outExt: t.outExt, camera: !!t.camera, urlInput: !!t.urlInput,
  actionLabel: t.actionLabel, dropHint: t.multiple ? "or drop files here" : "or drop a file here",
  next: (t.next || []).map(s => ({ slug: s, name: toolBySlug[s]?.name })).filter(x => x.name),
};
const path = `/${t.slug}`;
const lc = s => s.charAt(0).toLowerCase() + s.slice(1);
const howTitle = ["to-pdf", "from-pdf"].includes(t.category) ? `How to convert ${t.name}` : `How to ${lc(t.h1)}`;
const jsonld = [
  { "@context": "https://schema.org", "@type": "WebApplication", name: `${t.name} – ${SITE.name}`, url: SITE.url + path, applicationCategory: "UtilitiesApplication", operatingSystem: "Any (web browser)", browserRequirements: "Requires a modern browser with WebAssembly", description: t.description, offers: { "@type": "Offer", price: "0", priceCurrency: "INR" }, isAccessibleForFree: true },
  { "@context": "https://schema.org", "@type": "HowTo", name: `How to ${t.name.toLowerCase().replace(/^add /, "add ")} online for free`, totalTime: "PT1M", tool: { "@type": "HowToTool", name: SITE.name }, step: t.steps.map((s, i) => ({ "@type": "HowToStep", position: i + 1, text: s })) },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: t.faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" }, { "@type": "ListItem", position: 2, name: t.name, item: SITE.url + path }] },
];
const ours = t.server ? `1 file, ${t.maxMB} MB` : t.slug === "pdf-to-pdfa" ? "Free, no size cap*" : t.multiple ? "Unlimited files, no size cap*" : "No size cap*";
---
<Base title={t.title} description={t.description} path={path} jsonld={jsonld} api={!!t.server}>
  <section class="hero">
    <div class="wrap">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> › <a href={`/#${t.category}`}>{cat?.name}</a> › {t.name}</nav>
      <h1>{t.h1}</h1>
      <p class="sub">{t.sub}</p>
      <ul class="trust">
        <li>Free, no signup</li><li>No watermark</li>
        {t.server ? <li>Deleted right after conversion</li> : <li>Files never leave your device</li>}
        {!t.server && <li>No daily limits</li>}
      </ul>
      <div id="tool-app" data-slug={t.slug}><noscript><p>This tool needs JavaScript enabled.</p></noscript></div>
      <script type="application/json" id="tool-config" set:html={JSON.stringify(cfg)} />
      <script type="module" src="/app/app.js"></script>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <h2>About {t.name}</h2>
      {t.intro.map(p => <p>{p}</p>)}
      <h2>{howTitle}</h2>
      <ol class="steps">{t.steps.map(s => <li>{s}</li>)}</ol>
      <h2>Why use our {t.name} tool</h2>
      <ul>{t.features.map(f => <li>{f}</li>)}</ul>
      {ILOVE[t.slug] && (
        <>
          <h3>Free plan comparison</h3>
          <table class="compare-table">
            <thead><tr><th></th><th>{SITE.name}</th><th>iLovePDF (free)</th></tr></thead>
            <tbody>
              <tr><td>Limit per task</td><td class="yes">{ours}</td><td>{ILOVE[t.slug]}</td></tr>
              <tr><td>Where files are processed</td><td class="yes">{t.server ? "Our server, deleted immediately" : "On your device"}</td><td>Their servers</td></tr>
              <tr><td>Daily task limit</td><td class="yes">None</td><td>Limited</td></tr>
              <tr><td>Signup needed</td><td class="yes">No</td><td>No</td></tr>
            </tbody>
          </table>
          <p class="small muted">iLovePDF limits as listed on ilovepdf.com/pricing, {ILOVE_CHECKED}. {t.server ? "" : "*Limited only by your device's memory."} We are not affiliated with iLovePDF.</p>
        </>
      )}
      <h2>Frequently asked questions</h2>
      <div class="faq">{t.faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div>
      {guides.length > 0 && (<><h2>Guides</h2><ul>{guides.map(g => <li><a href={`/blog/${g.slug}`}>{g.title}</a></li>)}</ul></>)}
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <h2>Related tools</h2>
      <div class="tool-grid-home">
        {related.map(r => <a class="tool-tile" href={`/${r.slug}`}><ToolIcon icon={r.icon} /><div><strong>{r.name}</strong><span>{r.short}</span></div></a>)}
      </div>
    </div>
  </section>
</Base>
